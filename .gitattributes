# Finales de línea fijos en LF para todos, sin importar core.autocrlf (#32).
# En Windows la copia local puede tener CRLF; en el repo siempre entra LF.
* text=auto eol=lf

# Binarios: nunca se convierten ni se muestran como diff de texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary
*.MOV binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

{
  "name": "eclipse-condos-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "build": "cd apps/frontend && next build",
    "start": "cd apps/frontend && next start",
    "lint": "node -e \"console.log('lint pendiente de ESLint setup (P0)')\"",
    "dev:backend": "node -e \"console.log('Backend Laravel no inicializado todavia (P0).')\"",
    "dev:frontend": "cd apps/frontend && next dev",
    "setup": "npm install"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "latest",
    "react": "^19.2.3",
    "react-dom": "latest"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0"
  }
}
